# ==============================================================================
# Plantilla de Variables de Entorno para Despliegue — Pricecol / Nuvora Backend
# Copie este archivo a `.env` y reemplace los valores reales en su servidor.
# ==============================================================================

# 1. Seguridad, Hosts y Orígenes Permitidos (Producción / Staging)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change_me_to_a_long_random_secret_in_prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_PUBLICA,tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://tu-dominio.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://tu-dominio.com

# Permite que Django sirva /media/ incluso con DJANGO_DEBUG=False si Nginx no monta el volumen
SERVE_MEDIA_VIA_DJANGO=True

# 2. Base de Datos PostgreSQL
USE_POSTGRES=true
POSTGRES_DB=pricecol_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 3. Caché Redis y Cola Asíncrona Celery
USE_REDIS=True
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
